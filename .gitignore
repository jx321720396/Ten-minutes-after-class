# ---- Godot 4 ----
.godot/
/android/
*.translation

# ---- 构建与导出产物 ----
/build/
/dist/
/export/
*.pck
*.apk
*.aab
*.dmg
*.msi
*.idsig

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Office 临时文件（Word/Excel 打开时产生）----
~$*

# ---- Reasonix 本地配置与附件（含机器相关路径，不共享）----
.reasonix/
reasonix.toml

# ---- 本地开发工具（按机器配置，不入库）----
.cursor/
addons/godot-mcp/

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak
*.orig
# Blender 自动保存的上一版备份（真正源工程是 *.blend）
*.blend1
# 仓库根的本地临时目录：抓取脚本 / API 快照 / 一次性探针（不入库）
/tmp/

# ---- Python 缓存（tools/ 离线脚本用）----
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 本机 Godot 路径与离线导出产物（机器相关，不共享）----
.godot_path
/tools/out/

# ---- Godot 导出预设本地基准层（含本机 keystore 路径，不共享）----
.export_presets.base.cfg

# ---- 临时脚本与片段（.tmp-* / .frag-* 前缀）----
.tmp-*
.frag-*

# ---- 生成产物与运行期调试输出（不入库）----
/output/
capture_*.txt
