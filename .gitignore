# ---- Godot 4 ----
.godot/
/android/
*.translation

# ---- 构建与导出产物 ----
/build/
/dist/
/export/
*.pck
*.apk
*.aab
*.dmg
*.msi

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Office 临时文件（Word/Excel 打开时产生）----
~$*

# ---- Reasonix 本地配置与附件（含机器相关路径，不共享）----
.reasonix/
reasonix.toml

# ---- 本地开发工具（按机器配置，不入库）----
.cursor/
addons/godot-mcp/

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak
*.orig

# ---- Python 缓存（tools/ 离线脚本用）----
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 临时脚本与片段（.tmp-* / .frag-* 前缀）----
.tmp-*
.frag-*
